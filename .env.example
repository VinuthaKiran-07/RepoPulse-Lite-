# RepoPulse Lite — environment placeholders (copy to .env and fill values)
# NEVER commit real keys. This file contains placeholders only.

# Optional: raises GitHub API rate limit from 60 to 5,000 req/h
GITHUB_TOKEN=

# OpenAI-compatible LLM provider (Groq / Gemini OpenAI-compat / NVIDIA NIM / OpenRouter / tokenrouter)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=

# Optional: throttle for providers with strict RPM ceilings (e.g. tokenrouter free tier ~8 req/min)
LLM_REQUESTS_PER_MINUTE=8
